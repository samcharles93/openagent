{
  "name": "openagent",
  "version": "0.1.0",
  "private": true,
  "description": "Copilot CLI extension harness for orchestration-first software work",
  "type": "module",
  "author": "OpenAgent contributors",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "build": "bun run setup:copilot",
    "bundle": "bun build src/extension.mts --outfile dist/extension.mjs --target node --format esm --external @github/copilot-sdk --external @github/copilot-sdk/extension --external typescript --external jsonc-parser",
    "clean": "rm -rf .github/extensions/openagent/",
    "setup:agents": "bun run scripts/setup-copilot-agents.mjs",
    "setup:copilot": "bun run scripts/setup-openagent.mjs",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@ast-grep/cli": "^0.42.1",
    "@github/copilot": "^1.0.32",
    "@github/copilot-sdk": "1.0.0-beta.7",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "bun-types": "^1.3.13",
    "typescript": "^6.0.3"
  }
}
