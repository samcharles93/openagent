{
  "name": "openagent",
  "version": "0.1.0",
  "private": true,
  "description": "Copilot CLI extension harness for orchestration-first software work",
  "type": "module",
  "author": "OpenAgent contributors",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "build": "bun run setup:copilot",
    "clean": "bun run setup:copilot -- --clean",
    "setup:agents": "bun run scripts/setup-copilot-agents.mjs",
    "setup:copilot": "bun run scripts/setup-openagent.mjs",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@ast-grep/cli": "^0.42.1",
    "@github/copilot": "^1.0.32",
    "@github/copilot-sdk": "^0.2.2",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}
